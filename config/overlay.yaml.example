# 订阅控制台 overlay（复制为 overlay.yaml 后由 `uv run main.py console` 维护）
#
# load_feeds() 合并顺序:
#   1. sources.yaml 的 feeds
#   2. 按 name 套用 replacements（改内置源的 weight / title_regex / title_exclude_regex 等）
#   3. 追加本文件 feeds（控制台新加的知乎 / 通用 RSS）
#   4. 合并 wechat.yaml
#   5. 丢掉 disabled 里的名字
#
# 不要手改 sources.yaml 来增删源；内置源删除 = 写入 disabled。

feeds: []
replacements: []
disabled: []
