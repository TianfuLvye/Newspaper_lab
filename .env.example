# 复制为 .env 后按需填写。docker compose 会自动读取同目录 .env。
#
# 知乎部分路由需要登录 Cookie
# ZHIHU_COOKIES=d_c0=...; z_c0=...
#
# Lab 3.4 WeWe RSS 管理端授权码（docker-compose.wewe-rss.yml 读取）
# WEWE_AUTH_CODE=请改成你自己的随机字符串
#
# Lab 4:小红书 Cookie / 浏览器档案留在 third_party/MediaCrawler,不要写进本仓库
#
# Lab 7:可选 LLM。不填则用启发式,出报照常。
# FISHNET_LLM_API_KEY=
# FISHNET_LLM_BASE_URL=https://api.openai.com/v1
# FISHNET_LLM_FLASH_MODEL=gpt-4o-mini
# FISHNET_LLM_VISUAL_MODEL=gpt-4o-mini

# 火山引擎录音文件识别。当前账号用标准版资源 volc.seedasr.auc（不是极速版 turbo）。
# STT_API_KEY=
# STT_RESOURCE_ID=volc.seedasr.auc

# Lab 9:SMTP 邮件。密码/授权码不要提交。没配则 push 跳过、serve 照常出报。
# QQ 邮箱用 smtp.qq.com:465 + 授权码(不是登录密码);163 同理;Gmail 用 587 + STARTTLS。
# FISHNET_SMTP_HOST=smtp.qq.com
# FISHNET_SMTP_PORT=465
# FISHNET_SMTP_USER=you@qq.com
# FISHNET_SMTP_PASSWORD=
# FISHNET_SMTP_FROM=you@qq.com
# FISHNET_SMTP_TO=you@qq.com
# 587 才用 STARTTLS(Gmail)。465(QQ/163)是隐式 SSL,不要设 STARTTLS=1。
# FISHNET_SMTP_STARTTLS=1
